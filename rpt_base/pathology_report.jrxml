	</variable>
	<variable name="TOTAL_CONSULTATIONS" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[$F{CONSULTATIONS} == null ? 0L : $F{CONSULTATIONS}]]></variableExpression>
	</variable>
	<variable name="TOTAL_ADMISSIONS" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[$F{ADMISSIONS} == null ? 0L : $F{ADMISSIONS}]]></variableExpression>
	</variable>
	<variable name="TOTAL_HOSPITALIZED" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[$F{HOSPITALIZED} == null ? 0L : $F{HOSPITALIZED}]]></variableExpression>
	</variable>
	<variable name="SUM_TOTAL_DISCHARGES" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[$F{TOTAL_DISCHARGES} == null ? 0L : $F{TOTAL_DISCHARGES}]]></variableExpression>
	</variable>
