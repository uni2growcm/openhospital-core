	<field name="ADMISSIONS" class="java.lang.Long"/>
	<field name="HOSPITALIZED" class="java.lang.Long"/>
	<field name="TOTAL_DISCHARGES" class="java.lang.Long"/>
	<variable name="TOTAL_AGE_NEWBORN" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[$F{AGE_NEWBORN} == null ? 0L : $F{AGE_NEWBORN}]]></variableExpression>
	</variable>
	<variable name="TOTAL_AGE_EARLYCHILD" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[$F{AGE_EARLYCHILD} == null ? 0L : $F{AGE_EARLYCHILD}]]></variableExpression>
	</variable>
	<variable name="TOTAL_AGE_LATECHILD" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[$F{AGE_LATECHILD} == null ? 0L : $F{AGE_LATECHILD}]]></variableExpression>
	</variable>
	<variable name="TOTAL_AGE_ADOLESCENT" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[$F{AGE_ADOLESCENT} == null ? 0L : $F{AGE_ADOLESCENT}]]></variableExpression>
	</variable>
	<variable name="TOTAL_AGE_ADULT" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[$F{AGE_ADULT} == null ? 0L : $F{AGE_ADULT}]]></variableExpression>
	</variable>
	<variable name="TOTAL_AGE_ELDERLY" class="java.lang.Long" calculation="Sum">
