		<variableExpression><![CDATA[$F{CONSULTATIONS} == null ? 0 : $F{CONSULTATIONS}]]></variableExpression>
	</variable>
	<variable name="TOTAL_ADMISSIONS" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[$F{ADMISSIONS} == null ? 0 : $F{ADMISSIONS}]]></variableExpression>
	</variable>
	<variable name="TOTAL_HOSPITALIZED" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[$F{HOSPITALIZED} == null ? 0 : $F{HOSPITALIZED}]]></variableExpression>
	</variable>
	<variable name="TOTAL_NORMAL_DISCHARGE" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[$F{NORMAL_DISCHARGE} == null ? 0 : $F{NORMAL_DISCHARGE}]]></variableExpression>
	</variable>
	<variable name="TOTAL_ESCAPE_DISCHARGE" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[$F{ESCAPE_DISCHARGE} == null ? 0 : $F{ESCAPE_DISCHARGE}]]></variableExpression>
	</variable>
	<variable name="TOTAL_REFERRED" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[$F{REFERRED} == null ? 0 : $F{REFERRED}]]></variableExpression>
	</variable>
	<variable name="TOTAL_DEATHS" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[$F{DEATHS} == null ? 0 : $F{DEATHS}]]></variableExpression>
	</variable>
