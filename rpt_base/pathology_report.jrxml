<!-- Created with Jaspersoft Studio version 6.21.2.final using JasperReports Library version 6.21.2-8434a0bd7c3bbc37cbf916f2968d35e4b165821a  -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="pathology_by_age_gender" pageWidth="1133" pageHeight="793" orientation="Landscape" columnWidth="1073" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20" resourceBundle="pathology_by_age_gender" whenResourceMissingType="Key" uuid="4b130d5b-2220-460d-8b4b-de69fdbb4e1e">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="oh_data_adapter"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="fromdate" class="java.util.Date"/>
	<parameter name="todate" class="java.util.Date"/>
	<parameter name="LOGO-BENIN-PATH" class="java.lang.String"/>
	<parameter name="LOGO-PATH" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
		    COALESCE(d.DIS_DESC, '---') AS PATHOLOGY,
		
		    SUM(CASE WHEN w.WRD_IS_OPD = 0 AND ag.AT_CODE = 'd0' THEN 1 ELSE 0 END) AS AGE_NEWBORN,
		    SUM(CASE WHEN w.WRD_IS_OPD = 0 AND ag.AT_CODE = 'd1' THEN 1 ELSE 0 END) AS AGE_EARLYCHILD,
		    SUM(CASE WHEN w.WRD_IS_OPD = 0 AND ag.AT_CODE = 'd2' THEN 1 ELSE 0 END) AS AGE_LATECHILD,
		    SUM(CASE WHEN w.WRD_IS_OPD = 0 AND ag.AT_CODE = 'd3' THEN 1 ELSE 0 END) AS AGE_ADOLESCENT,
		    SUM(CASE WHEN w.WRD_IS_OPD = 0 AND ag.AT_CODE = 'd4' THEN 1 ELSE 0 END) AS AGE_ADULT,
		    SUM(CASE WHEN w.WRD_IS_OPD = 0 AND ag.AT_CODE = 'd5' THEN 1 ELSE 0 END) AS AGE_ELDERLY,
		
		    SUM(CASE WHEN w.WRD_IS_OPD = 1 THEN 1 ELSE 0 END) AS CONSULTATIONS,
		    SUM(CASE WHEN w.WRD_IS_OPD = 0 THEN 1 ELSE 0 END) AS ADMISSIONS,
		    SUM(CASE WHEN w.WRD_IS_OPD = 0 AND a.ADM_DATE_DIS IS NULL THEN 1 ELSE 0 END) AS HOSPITALIZED,
		    SUM(CASE WHEN w.WRD_IS_OPD = 0 AND a.ADM_DIST_ID_A = 'EQ' THEN 1 ELSE 0 END) AS NORMAL_DISCHARGE,
		    SUM(CASE WHEN w.WRD_IS_OPD = 0 AND a.ADM_DIST_ID_A = 'E' THEN 1 ELSE 0 END) AS ESCAPE_DISCHARGE,
		    SUM(CASE WHEN w.WRD_IS_OPD = 0 AND a.ADM_DIST_ID_A = 'B' THEN 1 ELSE 0 END) AS REFERRED,
		    SUM(CASE WHEN w.WRD_IS_OPD = 0 AND a.ADM_DIST_ID_A = 'D' THEN 1 ELSE 0 END) AS DEATHS
		    
		FROM oh_admission a
		INNER JOIN oh_patient p 
		    ON a.ADM_PAT_ID = p.PAT_ID
		LEFT JOIN oh_disease d 
		    ON a.ADM_IN_DIS_ID_A = d.DIS_ID_A
		LEFT JOIN oh_ward w 
		    ON a.ADM_WRD_ID_A = w.WRD_ID_A
		LEFT JOIN oh_agetype ag
		    ON COALESCE(p.PAT_AGE, -1) BETWEEN ag.AT_FROM AND ag.AT_TO
		    AND ag.AT_ACTIVE = 1
		WHERE DATE(a.ADM_DATE_ADM) BETWEEN $P{fromdate} AND $P{todate}
		    AND COALESCE(a.ADM_DELETED, 0) = 0
		    AND COALESCE(p.PAT_DELETED, 0) = 0
		GROUP BY COALESCE(d.DIS_DESC, '---')
		ORDER BY PATHOLOGY]]>
	</queryString>
	<field name="PATHOLOGY" class="java.lang.String"/>
	<field name="AGE_NEWBORN" class="java.lang.Long"/>
	<field name="AGE_EARLYCHILD" class="java.lang.Long"/>
	<field name="AGE_LATECHILD" class="java.lang.Long"/>
	<field name="AGE_ADOLESCENT" class="java.lang.Long"/>
	<field name="AGE_ADULT" class="java.lang.Long"/>
	<field name="AGE_ELDERLY" class="java.lang.Long"/>
	<field name="CONSULTATIONS" class="java.lang.Long"/>
	<field name="ADMISSIONS" class="java.lang.Long"/>
	<field name="HOSPITALIZED" class="java.lang.Long"/>
	<field name="NORMAL_DISCHARGE" class="java.lang.Long"/>
	<field name="ESCAPE_DISCHARGE" class="java.lang.Long"/>
	<field name="REFERRED" class="java.lang.Long"/>
	<field name="DEATHS" class="java.lang.Long"/>
	<variable name="TOTAL_AGE_NEWBORN" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[$F{AGE_NEWBORN} == null ? 0 : $F{AGE_NEWBORN}]]></variableExpression>
	</variable>
	<variable name="TOTAL_AGE_EARLYCHILD" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[$F{AGE_EARLYCHILD} == null ? 0 : $F{AGE_EARLYCHILD}]]></variableExpression>
	</variable>
	<variable name="TOTAL_AGE_LATECHILD" class="java.lang.Long" calculation="Sum">
