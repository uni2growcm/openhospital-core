	<parameter name="patID" class="java.lang.Integer"/>
	<parameter name="admID" class="java.lang.Integer"/>
	<parameter name="LOGO-BENIN-PATH" class="java.lang.String"/>
	<parameter name="LOGO-PATH" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
    p.*,
    a.*,
    GROUP_CONCAT(d.DIS_DESC SEPARATOR ', ') AS diseases
FROM oh_patient p
JOIN oh_admission a
    ON p.PAT_ID = a.ADM_PAT_ID
LEFT JOIN oh_indiagnosis i
    ON i.ID_ADM_ID = a.ADM_ID
LEFT JOIN oh_disease d
    ON d.DIS_ID_A = i.ID_DIS_ID_A
WHERE p.PAT_ID = 45
  AND a.ADM_ID = 515
GROUP BY p.PAT_ID, a.ADM_ID]]>
	</queryString>
	<field name="PAT_NAME" class="java.lang.String"/>
	<field name="PAT_AGE" class="java.lang.Integer"/>
