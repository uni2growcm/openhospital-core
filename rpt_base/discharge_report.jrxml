	<parameter name="LOGO-BENIN-PATH" class="java.lang.String"/>
	<parameter name="LOGO-PATH" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT * FROM oh_patient p
INNER JOIN oh_admission a
ON p.PAT_ID = a.ADM_PAT_ID
LEFT JOIN oh_disease d
ON d.DIS_ID_A = a.ADM_IN_DIS_ID_A
LEFT JOIN oh_dischargetype dist
ON dist.DIST_ID_A = a.ADM_DIST_ID_A
 WHERE p.PAT_ID = $P{patID}
AND a.ADM_ID = $P{admID}]]>
	</queryString>
