	</field>
	<field name="TOTAL_GENERAL_DEATH" class="java.lang.Long">
		<property name="com.jaspersoft.studio.field.name" value="TOTAL_GENERAL_DEATH"/>
		<property name="com.jaspersoft.studio.field.label" value="TOTAL_GENERAL_DEATH"/>
	</field>
	<field name="HOS_TELE" class="java.lang.String"/>
