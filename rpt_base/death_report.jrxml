<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="death_report" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" resourceBundle="death_report" uuid="9888f2b9-c540-4fa8-a768-c1ca4e6aaf84">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="DataAdapter.jrdax"/>
	<parameter name="LOGO-PATH" class="java.lang.String"/>
	<parameter name="LOGO-BENIN-PATH" class="java.lang.String"/>
	<parameter name="firstDate" class="java.sql.Timestamp"/>
	<parameter name="secondDate" class="java.sql.Timestamp"/>
	<queryString language="SQL">
		<![CDATA[SELECT 
    COUNT(CASE WHEN a.ADM_DEATH_PERIOD = 'BEFORE_ADMISSION' THEN 1 END) AS DEATH_BEFORE_ADMISSION,

    COUNT(CASE WHEN a.ADM_DEATH_PERIOD = 'AFTER_ADMISSION' 
               AND TIMESTAMPDIFF(HOUR, a.ADM_DATE_ADM, a.ADM_DATE_DIS) < 24 THEN 1 END) AS DEATH_LESS_24h,

    COUNT(CASE WHEN a.ADM_DEATH_PERIOD = 'AFTER_ADMISSION' 
               AND TIMESTAMPDIFF(HOUR, a.ADM_DATE_ADM, a.ADM_DATE_DIS) >= 24 THEN 1 END) AS DEATH_MORE_24h,

    COUNT(CASE WHEN a. ADM_DEATH_PERIOD IN ('BEFORE_ADMISSION', 'AFTER_ADMISSION') THEN 1 END) AS TOTAL_GENERAL_DEATH,
	h.HOS_TELE
FROM oh_admission a
CROSS JOIN oh_hospital h
WHERE a.ADM_DELETED = 'N'
  AND a.ADM_ACTIVE = 1
  AND a.ADM_CREATED_DATE BETWEEN $P{firstDate} AND $P{secondDate};]]>
	</queryString>
	<field name="DEATH_BEFORE_ADMISSION" class="java.lang.Long">
		<property name="com.jaspersoft.studio.field.name" value="DEATH_BEFORE_ADMISSION"/>
		<property name="com.jaspersoft.studio.field.label" value="DEATH_BEFORE_ADMISSION"/>
	</field>
	<field name="DEATH_LESS_24h" class="java.lang.Long">
		<property name="com.jaspersoft.studio.field.name" value="DEATH_LESS_24h"/>
