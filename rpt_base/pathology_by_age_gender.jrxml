                    $R{AGETYPE_ADOLESCENTS} + " (" + $V{LEG_FROM_D3} + "-" + $V{LEG_TO_D3} + ") | " +
                    $R{AGETYPE_ADULT} + " (" + $V{LEG_FROM_D4} + "-" + $V{LEG_TO_D4} + ") | " +
                    $R{AGETYPE_ELDERLY} + " (" + $V{LEG_FROM_D5} + "-" + $V{LEG_TO_D5} + ")"]]></textFieldExpression>
			</textField>
		</band>
	</summary>
</jasperReport>
