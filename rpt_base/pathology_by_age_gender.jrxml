<!-- Created with Jaspersoft Studio version 6.21.2.final using JasperReports Library version 6.21.2-8434a0bd7c3bbc37cbf916f2968d35e4b165821a  -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="pathology_by_age_gender" pageWidth="1133" pageHeight="793" orientation="Landscape" columnWidth="1073" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20" resourceBundle="pathology_by_age_gender" whenResourceMissingType="Key" uuid="4b130d5b-2220-460d-8b4b-de69fdbb4e1e">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="oh_data_adapter"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<parameter name="fromdate" class="java.util.Date"/>
	<parameter name="todate" class="java.util.Date"/>
	<parameter name="LOGO-BENIN-PATH" class="java.lang.String"/>
	<parameter name="LOGO-PATH" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT 
            COALESCE(d.DIS_DESC, '---') AS PATHOLOGY,
            SUM(CASE WHEN COALESCE(p.PAT_SEX, '') = 'M' AND ag.AT_CODE = 'd0' THEN 1 ELSE 0 END) AS NEWBORN_M,
            SUM(CASE WHEN COALESCE(p.PAT_SEX, '') = 'F' AND ag.AT_CODE = 'd0' THEN 1 ELSE 0 END) AS NEWBORN_F,
            SUM(CASE WHEN COALESCE(p.PAT_SEX, '') = 'M' AND ag.AT_CODE = 'd1' THEN 1 ELSE 0 END) AS EARLYCHILD_M,
            SUM(CASE WHEN COALESCE(p.PAT_SEX, '') = 'F' AND ag.AT_CODE = 'd1' THEN 1 ELSE 0 END) AS EARLYCHILD_F,
            SUM(CASE WHEN COALESCE(p.PAT_SEX, '') = 'M' AND ag.AT_CODE = 'd2' THEN 1 ELSE 0 END) AS LATECHILD_M,
            SUM(CASE WHEN COALESCE(p.PAT_SEX, '') = 'F' AND ag.AT_CODE = 'd2' THEN 1 ELSE 0 END) AS LATECHILD_F,
            SUM(CASE WHEN COALESCE(p.PAT_SEX, '') = 'M' AND ag.AT_CODE = 'd3' THEN 1 ELSE 0 END) AS ADOLESCENT_M,
            SUM(CASE WHEN COALESCE(p.PAT_SEX, '') = 'F' AND ag.AT_CODE = 'd3' THEN 1 ELSE 0 END) AS ADOLESCENT_F,
            SUM(CASE WHEN COALESCE(p.PAT_SEX, '') = 'M' AND ag.AT_CODE = 'd4' THEN 1 ELSE 0 END) AS ADULT_M,
            SUM(CASE WHEN COALESCE(p.PAT_SEX, '') = 'F' AND ag.AT_CODE = 'd4' THEN 1 ELSE 0 END) AS ADULT_F,
            SUM(CASE WHEN COALESCE(p.PAT_SEX, '') = 'M' AND ag.AT_CODE = 'd5' THEN 1 ELSE 0 END) AS ELDERLY_M,
            SUM(CASE WHEN COALESCE(p.PAT_SEX, '') = 'F' AND ag.AT_CODE = 'd5' THEN 1 ELSE 0 END) AS ELDERLY_F,
            SUM(CASE WHEN COALESCE(p.PAT_SEX, '') = 'M' THEN 1 ELSE 0 END) AS TOTAL_MALE,
            SUM(CASE WHEN COALESCE(p.PAT_SEX, '') = 'F' THEN 1 ELSE 0 END) AS TOTAL_FEMALE,
            COUNT(*) AS TOTAL_CASES,
            MAX(CASE WHEN ag.AT_CODE = 'd0' THEN ag.AT_FROM END) AS AGE_FROM_D0,
            MAX(CASE WHEN ag.AT_CODE = 'd0' THEN ag.AT_TO   END) AS AGE_TO_D0,
            MAX(CASE WHEN ag.AT_CODE = 'd1' THEN ag.AT_FROM END) AS AGE_FROM_D1,
            MAX(CASE WHEN ag.AT_CODE = 'd1' THEN ag.AT_TO   END) AS AGE_TO_D1,
            MAX(CASE WHEN ag.AT_CODE = 'd2' THEN ag.AT_FROM END) AS AGE_FROM_D2,
            MAX(CASE WHEN ag.AT_CODE = 'd2' THEN ag.AT_TO   END) AS AGE_TO_D2,
            MAX(CASE WHEN ag.AT_CODE = 'd3' THEN ag.AT_FROM END) AS AGE_FROM_D3,
            MAX(CASE WHEN ag.AT_CODE = 'd3' THEN ag.AT_TO   END) AS AGE_TO_D3,
            MAX(CASE WHEN ag.AT_CODE = 'd4' THEN ag.AT_FROM END) AS AGE_FROM_D4,
            MAX(CASE WHEN ag.AT_CODE = 'd4' THEN ag.AT_TO   END) AS AGE_TO_D4,
            MAX(CASE WHEN ag.AT_CODE = 'd5' THEN ag.AT_FROM END) AS AGE_FROM_D5,
            MAX(CASE WHEN ag.AT_CODE = 'd5' THEN ag.AT_TO   END) AS AGE_TO_D5
        FROM oh_admission a
        INNER JOIN oh_patient p ON a.ADM_PAT_ID = p.PAT_ID
        LEFT JOIN oh_disease d ON a.ADM_IN_DIS_ID_A = d.DIS_ID_A
        LEFT JOIN oh_agetype ag ON COALESCE(p.PAT_AGE, -1) BETWEEN ag.AT_FROM AND ag.AT_TO AND ag.AT_ACTIVE = 1
        WHERE CAST(a.ADM_DATE_ADM AS DATE) BETWEEN $P{fromdate} AND $P{todate}
          AND COALESCE(a.ADM_DELETED, 0) = 0
          AND COALESCE(p.PAT_DELETED, 0) = 0
        GROUP BY COALESCE(d.DIS_DESC, '---')
        ORDER BY PATHOLOGY]]>
	</queryString>
