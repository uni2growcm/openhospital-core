<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="PathologyByAgeGender" pageWidth="1133" pageHeight="793" orientation="Landscape" columnWidth="1073" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20" resourceBundle="PathologyByAgeGender" whenResourceMissingType="Key" uuid="4b130d5b-2220-460d-8b4b-de69fdbb4e1e">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="oh_data_adapter"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="fromdate" class="java.util.Date"/>
	<parameter name="todate" class="java.util.Date"/>
	<parameter name="Hospital" class="java.lang.String" isForPrompting="false"/>
	<parameter name="Address" class="java.lang.String" isForPrompting="false"/>
	<parameter name="City" class="java.lang.String" isForPrompting="false"/>
	<parameter name="Email" class="java.lang.String" isForPrompting="false"/>
	<parameter name="Telephone" class="java.lang.String" isForPrompting="false"/>
	<parameter name="LOGO_PATH" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["./rsc/images/"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT 
            COALESCE(d.DIS_DESC, '---') AS PATHOLOGY,
            ag.AT_CODE AS AGE_GROUP_CODE,
            ag.AT_FROM AS AGE_FROM,
            ag.AT_TO AS AGE_TO,
            SUM(CASE WHEN COALESCE(p.PAT_SEX, '') = 'M' THEN 1 ELSE 0 END) AS MALE,
            SUM(CASE WHEN COALESCE(p.PAT_SEX, '') = 'F' THEN 1 ELSE 0 END) AS FEMALE,
            COUNT(*) AS TOTAL_CASES
        FROM oh_admission a
        INNER JOIN oh_patient p 
            ON a.ADM_PAT_ID = p.PAT_ID
        LEFT JOIN oh_disease d 
            ON a.ADM_YPROG = d.DIS_ID_A
        LEFT JOIN oh_agetype ag 
            ON COALESCE(p.PAT_AGE, -1) BETWEEN ag.AT_FROM AND ag.AT_TO
            AND ag.AT_ACTIVE = 1
        WHERE CAST(a.ADM_DATE_ADM AS DATE) BETWEEN $P{fromdate} AND $P{todate}
            AND COALESCE(a.ADM_DELETED, 0) = 0
            AND COALESCE(p.PAT_DELETED, 0) = 0
        GROUP BY 
            COALESCE(d.DIS_DESC, '---'),
            ag.AT_CODE,
            ag.AT_FROM,
            ag.AT_TO
        ORDER BY 
            PATHOLOGY,
            ag.AT_FROM]]>
	</queryString>
