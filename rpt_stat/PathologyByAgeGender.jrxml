	<field name="TOTAL_CASES" class="java.lang.Long"/>
	<variable name="TOTAL_MALE" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[$F{MALE} == null ? 0 : $F{MALE}]]></variableExpression>
	</variable>
	<variable name="TOTAL_FEMALE" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[$F{FEMALE} == null ? 0 : $F{FEMALE}]]></variableExpression>
	</variable>
	<variable name="GRAND_TOTAL" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[$F{TOTAL_CASES} == null ? 0 : $F{TOTAL_CASES}]]></variableExpression>
	</variable>
	<variable name="AGE_FROM_d0" class="java.lang.Integer" calculation="Highest">
