<!-- Created with Jaspersoft Studio version 6.21.2.final using JasperReports Library version 6.21.2-8434a0bd7c3bbc37cbf916f2968d35e4b165821a  -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="PathologyReport" pageWidth="1133" pageHeight="793" orientation="Landscape" columnWidth="1073" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20" resourceBundle="PathologyReport" whenResourceMissingType="Key" uuid="c1d2e3f4-a5b6-7890-cdef-123456789abc">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="oh_data_adapter"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<import value="net.sf.jasperreports.engine.data.*"/>
	<parameter name="fromdate" class="java.util.Date"/>
	<parameter name="todate" class="java.util.Date"/>
	<parameter name="Hospital" class="java.lang.String" isForPrompting="false"/>
	<parameter name="Address" class="java.lang.String" isForPrompting="false"/>
	<parameter name="City" class="java.lang.String" isForPrompting="false"/>
	<parameter name="Email" class="java.lang.String" isForPrompting="false"/>
	<parameter name="Telephone" class="java.lang.String" isForPrompting="false"/>
	<parameter name="LOGO_PATH" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["./rsc/images/"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
            d.DIS_ID_A                              AS PATHOLOGY_CODE,
            COALESCE(d.DIS_DESC, '---')             AS PATHOLOGY_DESC,
            ag.AT_CODE                              AS AGE_GROUP_CODE,
            ag.AT_FROM                              AS AGE_FROM,
            ag.AT_TO                                AS AGE_TO,

            SUM(CASE WHEN w.WRD_IS_OPD = 1
                     THEN 1 ELSE 0 END)             AS CONSULTATIONS,

            SUM(CASE WHEN w.WRD_IS_OPD = 0
                     THEN 1 ELSE 0 END)             AS ADMISSIONS,

            SUM(CASE WHEN w.WRD_IS_OPD = 0
                      AND a.ADM_DATE_DIS IS NULL
                     THEN 1 ELSE 0 END)             AS HOSPITALIZED,

            SUM(CASE WHEN w.WRD_IS_OPD = 0
                      AND a.ADM_DIST_ID_A = 'EQ'
                     THEN 1 ELSE 0 END)             AS NORMALE_DISCHARGE,
            SUM(CASE WHEN w.WRD_IS_OPD = 0
                      AND a.ADM_DIST_ID_A = 'ES'
                     THEN 1 ELSE 0 END)             AS ESCAPE_DISCHARGE,
            SUM(CASE WHEN w.WRD_IS_OPD = 0
                      AND a.ADM_DIST_ID_A = 'B'
                     THEN 1 ELSE 0 END)             AS REFERRED_DISCHARGE,
            SUM(CASE WHEN w.WRD_IS_OPD = 0
                      AND a.ADM_DIST_ID_A = 'D'
                     THEN 1 ELSE 0 END)             AS DEATHS

        FROM oh_admission a
        INNER JOIN oh_patient p
            ON a.ADM_PAT_ID = p.PAT_ID
        LEFT JOIN oh_disease d
            ON a.ADM_IN_DIS_ID_A = d.DIS_ID_A
        LEFT JOIN oh_ward w
            ON a.ADM_WRD_ID_A = w.WRD_ID_A
        LEFT JOIN oh_agetype ag
            ON COALESCE(p.PAT_AGE, -1) BETWEEN ag.AT_FROM AND ag.AT_TO
            AND ag.AT_ACTIVE = 1
        WHERE
            (
                DATE(a.ADM_DATE_ADM) BETWEEN $P{fromdate} AND $P{todate}
                OR
                DATE(a.ADM_DATE_DIS) BETWEEN $P{fromdate} AND $P{todate}
            )
            AND COALESCE(a.ADM_DELETED, 'N') = 'N'
            AND COALESCE(p.PAT_DELETED, 0)   = 0
        GROUP BY
            d.DIS_ID_A,
            COALESCE(d.DIS_DESC, '---'),
            ag.AT_CODE,
            ag.AT_FROM,
            ag.AT_TO
        ORDER BY
            PATHOLOGY_DESC,
            ag.AT_FROM]]>
	</queryString>
