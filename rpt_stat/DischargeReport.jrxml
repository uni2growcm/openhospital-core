<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="DischargeStatisticsReport" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" resourceBundle="DischargeReport" uuid="15801daf-ab44-4545-89e2-846635be8085">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="oh_data_adapter"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<parameter name="Hospital" class="java.lang.String" isForPrompting="false"/>
	<parameter name="Address" class="java.lang.String" isForPrompting="false"/>
	<parameter name="City" class="java.lang.String" isForPrompting="false"/>
	<parameter name="Email" class="java.lang.String" isForPrompting="false"/>
	<parameter name="Telephone" class="java.lang.String" isForPrompting="false"/>
	<parameter name="PATH_LOGO" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["./rsc/images/"]]></defaultValueExpression>
	</parameter>
	<parameter name="fromdate" class="java.util.Date"/>
	<parameter name="todate" class="java.util.Date"/>
	<queryString>
		<![CDATA[SELECT
            w.WRD_NAME AS WARD_NAME,
            COALESCE(dt.DIST_DESC, 'Undefined') AS DISCHARGE_TYPE,
            COUNT(*) AS NUMBER
        FROM oh_admission a
        LEFT JOIN oh_ward w ON a.ADM_WRD_ID_A = w.WRD_ID_A
        LEFT JOIN oh_dischargetype dt ON a.ADM_DIST_ID_A = dt.DIST_ID_A AND dt.DIST_ACTIVE = 1
        WHERE
            a.ADM_DATE_DIS IS NOT NULL
            AND DATE(a.ADM_DATE_DIS) BETWEEN $P{fromdate} AND $P{todate}
            AND a.ADM_ACTIVE = 1
            AND w.WRD_ACTIVE = 1
            AND w.WRD_IS_OPD = 0
        GROUP BY w.WRD_NAME, dt.DIST_DESC
        ORDER BY w.WRD_NAME, dt.DIST_DESC]]>
	</queryString>
	<field name="WARD_NAME" class="java.lang.String"/>
	<field name="DISCHARGE_TYPE" class="java.lang.String"/>
	<field name="NUMBER" class="java.lang.Long"/>
	<variable name="WARD_TOTAL" class="java.lang.Long" resetType="Group" resetGroup="WARD_GROUP" calculation="Sum">
		<variableExpression><![CDATA[$F{NUMBER} == null ? 0L : $F{NUMBER}]]></variableExpression>
	</variable>
	<variable name="GRAND_TOTAL" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[$F{NUMBER} == null ? 0L : $F{NUMBER}]]></variableExpression>
	</variable>
