	<parameter name="fromdate" class="java.util.Date"/>
	<parameter name="todate" class="java.util.Date"/>
	<parameter name="Hospital" class="java.lang.String" isForPrompting="false"/>
	<parameter name="Address" class="java.lang.String" isForPrompting="false"/>
	<parameter name="City" class="java.lang.String" isForPrompting="false"/>
	<parameter name="Email" class="java.lang.String" isForPrompting="false"/>
	<parameter name="Telephone" class="java.lang.String" isForPrompting="false"/>
	<parameter name="LOGO_PATH" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["./rsc/images/"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT 
			A.ADM_ID AS CODE,
			P.PAT_ID,
			CONCAT(P.PAT_FNAME, ' ', P.PAT_NAME) AS PAT_NAME,
			P.PAT_SEX,
			P.PAT_AGE,
			CAST(A.ADM_DATE_ADM AS DATE) AS DATE_ADM,
			W.WRD_NAME AS WARD,
			D.DIS_DESC AS DISEASE, 
			ATYPE.ADMT_DESC AS ADM_TYPE  
		FROM OH_ADMISSION A
		INNER JOIN OH_PATIENT P 
			ON A.ADM_PAT_ID = P.PAT_ID
		LEFT JOIN OH_WARD W 
			ON A.ADM_WRD_ID_A = W.WRD_ID_A
		LEFT JOIN OH_DISEASE D 
			ON A.ADM_YPROG = D.DIS_ID_A
		LEFT JOIN OH_ADMISSIONTYPE atype 
			ON A.ADM_ADMT_ID_A_ADM = ATYPE.ADMT_ID_A 
		WHERE CAST(A.ADM_DATE_ADM AS DATE) BETWEEN $P{fromdate} AND $P{todate}
			AND A.ADM_DELETED = 0
			AND P.PAT_DELETED = 0
		ORDER BY A.ADM_DATE_ADM DESC]]>
	</queryString>
	<field name="CODE" class="java.lang.Integer"/>
	<field name="PAT_ID" class="java.lang.Integer"/>
	<field name="PAT_NAME" class="java.lang.String"/>
	<field name="PAT_SEX" class="java.lang.String"/>
	<field name="PAT_AGE" class="java.lang.Integer"/>
	<field name="DATE_ADM" class="java.sql.Date"/>
	<field name="WARD" class="java.lang.String"/>
	<field name="DISEASE" class="java.lang.String"/>
	<field name="ADM_TYPE" class="java.lang.String"/>
	<variable name="TOTAL" class="java.lang.Long" calculation="Count">
		<variableExpression><![CDATA[$F{CODE}]]></variableExpression>
	</variable>
